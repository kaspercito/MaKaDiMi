<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Pantalla de arranque de Android 12+. El sistema recorta el icono en un círculo de 2/3 del
        tamaño, por eso usa splash_icon (el logo reducido, con el aro dentro de la zona segura)
        en vez del icono del launcher, que se veía cortado y raro.
    -->
    <style name="Theme.Makadimi" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">#FF06040F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
